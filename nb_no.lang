value.WEATHER_SPLASH_QUALITY.2=§eMiddels
value.WEATHER_SPLASH_QUALITY.3=§4Høy
option.SNOW_WIND_DRIFT=§fVinddrift i snø
option.SNOW_WIND_DRIFT.comment=Hvor kraftig vinden blåser snøen til siden og virvler den rundt.
suffix.RAIN_OPACITY=%
suffix.SNOW_WIND_DRIFT=%
option.SNOW_QUALITY=§fRegn og snø
option.SNOW_QUALITY.comment=Regn og snø i ekte dybde, tegnet av pakken: myke fnugg og tynne striper som lener seg i vinden og fanger lyset fra fakler. De faller aldri under tak. Ultra legger til flere lag lenger unna.
value.SNOW_QUALITY.1=§e3D Smooth
value.SNOW_QUALITY.2=§4Ultra
option.GLASS_WEATHER_EFFECTS=§bVær på glass
option.GLASS_WEATHER_EFFECTS.comment=I regn sitter dråper på vinduene og glir sakte nedover, og de bøyer det du ser gjennom glasset. I snø vokser det rim inn fra kantene av rutene.
option.GROUND_SPLASH_PARTICLES=§bRegnplask
option.GROUND_SPLASH_PARTICLES.comment=Små dråper spretter opp der regnet treffer bakken. Kraftigere regn gir flere og høyere dråper.
